{
  "expo": {
    "name": "Parallel Lives",
    "slug": "parallel-lives",
    "scheme": "parallel-lives-login",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0c1020"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to add to your shared room."
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location confirms Pune eligibility and helps find a nearby companion. It is never shown to your companion."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}
